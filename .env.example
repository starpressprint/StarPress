# ============================================================================
# Star Press — Environment Variables (.env.local / Railway Production)
# ============================================================================

# Application
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Database (Supabase PostgreSQL / Local Postgres)
DATABASE_URL="postgresql://postgres:password@localhost:5432/starpress?sslmode=prefer"

# NextAuth Security
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="development-secret-key-32-chars-min"

# File Storage (Supabase Storage)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# Razorpay Production / Test Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Transactional Email (Resend)
RESEND_API_KEY=""
NOTIFICATION_EMAIL="orders@starpress.in"
ORDER_NOTIFY_EMAIL="owner@starpress.in"
OWNER_ALERT_EMAIL="owner@starpress.in"

# Cron Secret for Vercel Cron endpoints
CRON_SECRET="generate-a-random-64-char-hex-string"

# Admin Email Whitelist (Comma-separated, trimmed, lowercased)
# Grants administrative privileges to confirmed Supabase user accounts matching these emails.
ADMIN_EMAILS="owner@example.com,admin@example.com"

# Distributed Rate Limiting (Optional - Upstash Redis or Vercel KV)
# If omitted, automatically falls back to in-memory sliding window
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Order Payment Window (minutes before unpaid inventory reservation expires)
ORDER_PAYMENT_WINDOW_MINUTES="60"
