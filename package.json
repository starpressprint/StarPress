{
  "name": "star-press",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "DATABASE_URL=\"${DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/dummy?schema=public}\" prisma generate && next build",
    "postinstall": "DATABASE_URL=\"${DATABASE_URL:-postgresql://postgres:postgres@localhost:5432/dummy?schema=public}\" prisma generate || true",
    "start": "next start",
    "lint": "next lint",
    "test:security": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/test-security.ts",
    "test:quote": "ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/test-quote.ts",
    "test:refund": "ts-node -r tsconfig-paths/register --compiler-options '{\"module\":\"commonjs\"}' scripts/test-refund-accounting.ts",
    "prisma:studio": "prisma studio",
    "prisma:migrate": "prisma migrate dev"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.109.0",
    "bcryptjs": "^2.4.3",
    "lucide-react": "^1.45.0",
    "next": "^14.2.0",
    "next-auth": "^4.24.0",
    "prisma": "^5.18.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.2.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  }
}
